<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_nutrition_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="Nutrition"
                android:textColor="@color/text_main"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Daily Calorie Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calorie_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/tv_nutrition_title">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_calories_circular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:progress="65"
                        app:indicatorColor="@color/brand_lavender"
                        app:indicatorSize="160dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:trackColor="#F3E8FF"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/progress_calories_circular"
                        app:layout_constraintEnd_toEndOf="@id/progress_calories_circular"
                        app:layout_constraintStart_toStartOf="@id/progress_calories_circular"
                        app:layout_constraintTop_toTopOf="@id/progress_calories_circular">

                        <TextView
                            android:id="@+id/tv_calories_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1,240"
                            android:textColor="@color/text_main"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kcal left"
                            android:textColor="@color/text_sub"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/progress_calories_circular">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_consumed_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1,260"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Eaten"
                                android:textColor="@color/text_sub"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:background="@color/border_subtle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_burned_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="320"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Burned"
                                android:textColor="@color/text_sub"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Macros Grid -->
            <GridLayout
                android:id="@+id/layout_macros_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                app:layout_constraintTop_toBottomOf="@id/card_calorie_summary">

                <!-- Protein -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="#FEF2F2"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Protein"
                            android:textColor="@color/danger_red"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_protein_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="82g"
                            android:textColor="@color/danger_red"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_protein"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:progress="60"
                            app:indicatorColor="#DC2626"
                            app:trackColor="#FEE2E2"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Carbs -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="#FEFCE8"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carbs"
                            android:textColor="@color/warning_amber"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_carbs_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="145g"
                            android:textColor="@color/warning_amber"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_carbs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:progress="45"
                            app:indicatorColor="#D97706"
                            app:trackColor="#FEF9C3"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Fat -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="#EFF6FF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fat"
                            android:textColor="@color/primary_blue"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_fat_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="42g"
                            android:textColor="@color/primary_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_fat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:progress="70"
                            app:indicatorColor="#2563EB"
                            app:trackColor="#DBEAFE"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- Hydration Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hydration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/layout_macros_grid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_white_circle"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="@color/brand_sky" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hydration"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_water_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1,200 / 2,400 ml"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_water"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:backgroundTint="#EFF6FF"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconTint="@color/brand_sky" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_today_log_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Today's Log"
                android:textColor="@color/text_main"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_hydration" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_meals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tv_today_log_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_meal"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="AI Scan"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/brand_sky"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_log_meal"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Log Manual"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/brand_lavender"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_edit" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan_barcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:text="Barcode"
        android:textColor="@color/text_main"
        android:translationY="-80dp"
        app:backgroundTint="@color/bg_card"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_search"
        app:iconTint="@color/brand_sky"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
